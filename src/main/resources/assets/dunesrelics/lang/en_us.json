  "villager.dunesrelics.greet.hostile.friendly": "...I'd rather you kept your distance, %s.",
  "villager.dunesrelics.greet.hostile.grumpy": "You again. Clear off.",
  "villager.dunesrelics.greet.hostile.greedy": "Not a single emerald for you, thief.",
  "villager.dunesrelics.greet.hostile.brave": "I'm watching you, %s.",
  "villager.dunesrelics.greet.neutral.friendly": "Good day to you, stranger!",
  "villager.dunesrelics.greet.neutral.grumpy": "Hmph.",
  "villager.dunesrelics.greet.neutral.greedy": "Buying or selling?",
  "villager.dunesrelics.greet.neutral.brave": "Keep safe out there.",
  "villager.dunesrelics.greet.friendly.friendly": "%s! So good to see you!",
  "villager.dunesrelics.greet.friendly.grumpy": "Oh, it's you. ...Good.",
  "villager.dunesrelics.greet.friendly.greedy": "For you, a special price. Almost.",
  "villager.dunesrelics.greet.friendly.brave": "Good to have you around, %s.",
  "villager.dunesrelics.greet.hero.friendly": "Everyone, look! %s is here!",
  "villager.dunesrelics.greet.hero.grumpy": "...Thank you. For everything.",
  "villager.dunesrelics.greet.hero.greedy": "Take whatever you need. Well, nearly.",
  "villager.dunesrelics.greet.hero.brave": "If there's trouble, I'm with you, %s.",
  "villager.dunesrelics.gift.friendly": "Here, I saved this for you.",
  "villager.dunesrelics.gift.grumpy": "Take it. Don't make a fuss.",
  "villager.dunesrelics.gift.greedy": "A gift. Free. Don't get used to it.",
  "villager.dunesrelics.gift.brave": "For the road. You'll need it.",
  "villager.dunesrelics.thanks.friendly": "Oh, how lovely! Thank you!",
  "villager.dunesrelics.thanks.grumpy": "...Fine. Thank you.",
  "villager.dunesrelics.thanks.greedy": "Now that's what I call a gift!",
  "villager.dunesrelics.thanks.brave": "I'll remember this, friend.",
  "villager.dunesrelics.angry.friendly": "Why would you break that?!",
  "villager.dunesrelics.angry.grumpy": "Hey! That's ours!",
  "villager.dunesrelics.angry.greedy": "You'll pay for that!",
  "villager.dunesrelics.angry.brave": "Stop right there!",
  "item.dunesrelics.message_in_a_bottle.note.0": "The note is faded: \"...the treasure lies where the palms...\"",
  "item.dunesrelics.message_in_a_bottle.note.1": "\"If you find this, we are safe. The sea was kind.\"",
  "item.dunesrelics.message_in_a_bottle.note.2": "A child's drawing of a ship with black sails.",
  "item.dunesrelics.message_in_a_bottle.note.3": "\"Beware the captain with the golden hat.\"",
  "item.dunesrelics.message_in_a_bottle.note.4": "\"The tide keeps its secrets for those who wait.\"",
  "item.dunesrelics.message_in_a_bottle.note.5": "Just one word: \"Home.\""
}
